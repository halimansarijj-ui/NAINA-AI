rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data) {
      return data.userId is string &&
             data.userId == request.auth.uid &&
             data.userId.size() <= 128 &&
             data.displayName is string &&
             data.displayName.size() <= 100 &&
             data.email is string &&
             data.email.size() <= 200 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.preferredLanguage is string &&
             data.preferredLanguage in ['HINDI', 'URDU', 'HINGLISH', 'ENGLISH'];
    }

    function isValidCreation(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId.size() <= 128 &&
             data.kind is string &&
             data.kind in ['WEBSITE', 'GAME', 'KOTLIN', 'PROMPT'] &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.prompt is string &&
             data.prompt.size() >= 1 &&
             data.prompt.size() <= 1000 &&
             data.content is string &&
             data.content.size() >= 1 &&
             data.content.size() <= 100000;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       incoming().keys().hasAll(['userId', 'displayName', 'email', 'preferredLanguage', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'photoUrl', 'preferredLanguage', 'createdAt', 'updatedAt']) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidUserProfile(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoUrl', 'preferredLanguage', 'updatedAt']);

      allow delete: if isOwner(userId) && isValidId(userId);

      match /creations/{creationId} {
        allow get: if isOwner(userId) && isValidId(creationId);
        allow list: if isOwner(userId);

        allow create: if isOwner(userId) &&
                         isValidId(creationId) &&
                         incoming().keys().hasAll(['userId', 'kind', 'title', 'prompt', 'content', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'kind', 'title', 'prompt', 'content', 'createdAt', 'updatedAt']) &&
                         incoming().createdAt is timestamp &&
                         incoming().createdAt <= request.time &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         isValidCreation(incoming(), userId);

        allow update: if isOwner(userId) &&
                         isValidId(creationId) &&
                         isValidCreation(incoming(), userId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().updatedAt is timestamp &&
                         incoming().updatedAt <= request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'prompt', 'content', 'updatedAt']);

        allow delete: if isOwner(userId) && isValidId(creationId);
      }
    }
  }
}
